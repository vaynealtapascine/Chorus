    },
    {
      "key": "digest_only",
      "label": "Digest only",
      "kind": "bool",
      "default": false
    },
    {
      "key": "max_per_day",
      "label": "Most pings a day",
      "hint": "Past it, the rest go in the digest",
      "kind": "limit",
      "default": null
