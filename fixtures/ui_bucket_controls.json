  "fields": [
    {
      "key": "switch_notifications",
      "label": "Switch notifications",
      "hint": "Off still reveals the front on schedule, without a ping",
      "kind": "bool",
      "default": true
    },
    {
      "key": "levels",
      "label": "Layers they hear about",
      "kind": "levels",
      "default": [
        "front",
        "cocon"
      ],
      "choices": [
        "front",
        "cocon",
        "present"
      ]
