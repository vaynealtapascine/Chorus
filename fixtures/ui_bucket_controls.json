        "min_s": 300,
        "max_s": 1200
      }
    },
    {
      "key": "extra_delay",
      "label": "Extra delay, when a switch asks for it",
      "kind": "range",
      "default": {
        "min_s": 1800,
        "max_s": 7200
      }
    },
    {
      "key": "allow_now",
      "label": "Allow “notify now”",
      "kind": "bool",
      "default": true
    },
    {
      "key": "time",
      "label": "Time shown",
      "hint": "Hides the exact time afterwards",
      "kind": "time",
      "default": {
        "mode": "round",
        "round_min": 15
      },
      "choices": [
        "exact",
        "round",
        "jitter",
        "part_of_day",
        "hidden"
      ]
    },
    {
      "key": "stacking",
      "label": "Several switches in a row",
      "kind": "enum",
      "default": "collapse",
      "choices": [
        "collapse",
        "sequence"
