{
  "comment": "D-101: who each profile part or custom field is shared with, before the profile's own limit. Web profile-audience.ts and Android ProfileAudience.kt both read this.",
  "buckets": { "b1": "Close friends", "b2": "Discord" },
  "cases": [
    { "name": "unset part follows the profile", "profile": { "mode": "followers" }, "parts": {}, "key": "pronouns", "audience": { "mode": "followers" }, "label": "Friends" },
    { "name": "own audience wins", "profile": { "mode": "followers" }, "parts": { "pronouns": { "mode": "private" } }, "key": "pronouns", "audience": { "mode": "private" }, "label": "Only us" },
    { "name": "no parts map at all", "profile": { "mode": "server" }, "parts": null, "key": "birthday", "audience": { "mode": "server" }, "label": "Everyone here" },
    { "name": "parts map of the wrong shape hides everything", "profile": { "mode": "server" }, "parts": [1], "key": "birthday", "audience": { "mode": "private" }, "label": "Only us" },
    { "name": "unknown mode fails closed", "profile": { "mode": "followers" }, "parts": { "banner": { "mode": "everyone" } }, "key": "banner", "audience": { "mode": "private" }, "label": "Only us" },
    { "name": "one bucket shows its name", "profile": { "mode": "followers" }, "parts": { "birthday": { "mode": "buckets", "bucket_ids": ["b1"] } }, "key": "birthday", "audience": { "mode": "buckets", "bucket_ids": ["b1"] }, "label": "Close friends" },
    { "name": "several buckets count", "profile": { "mode": "buckets", "bucket_ids": ["b1", "b2"] }, "parts": {}, "key": "description", "audience": { "mode": "buckets", "bucket_ids": ["b1", "b2"] }, "label": "2 buckets" },
    { "name": "deleted buckets share with nobody", "profile": { "mode": "buckets", "bucket_ids": ["gone"] }, "parts": {}, "key": "description", "audience": { "mode": "buckets", "bucket_ids": ["gone"] }, "label": "Only us" },
    { "name": "missing profile audience is private", "profile": null, "parts": {}, "key": "pronouns", "audience": { "mode": "private" }, "label": "Only us" },
    { "name": "custom field follows its default", "profile": { "mode": "followers" }, "parts": {}, "key": "f-roles", "default": { "mode": "server" }, "audience": { "mode": "server" }, "label": "Everyone here" },
    { "name": "custom field with no default is private", "profile": { "mode": "followers" }, "parts": {}, "key": "f-loc", "default": null, "audience": { "mode": "private" }, "label": "Only us" },
    { "name": "custom field's own choice wins", "profile": { "mode": "followers" }, "parts": { "f-loc": { "mode": "followers" } }, "key": "f-loc", "default": { "mode": "private" }, "audience": { "mode": "followers" }, "label": "Friends" }
  ],
  "post_default": [
    {"name": "nothing chosen is only us", "value": null, "audience": {"mode": "private"}},
    {"name": "friends", "value": {"mode": "followers"}, "audience": {"mode": "followers"}},
    {"name": "everyone here", "value": {"mode": "server"}, "audience": {"mode": "server"}},
    {"name": "buckets stay while they live", "value": {"mode": "buckets", "bucket_ids": ["b2", "b1"]}, "audience": {"mode": "buckets", "bucket_ids": ["b2", "b1"]}},
    {"name": "a deleted bucket drops out", "value": {"mode": "buckets", "bucket_ids": ["gone", "b1"]}, "audience": {"mode": "buckets", "bucket_ids": ["b1"]}},
    {"name": "with every bucket gone it is only us", "value": {"mode": "buckets", "bucket_ids": ["gone"]}, "audience": {"mode": "private"}},
    {"name": "a malformed one is only us", "value": {"mode": "everyone"}, "audience": {"mode": "private"}}
  ]
}
