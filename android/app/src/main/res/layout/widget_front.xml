<?xml version="1.0" encoding="utf-8"?>
<!-- Front at a glance (Figma F3.8): the front's orbit, who's on each layer, Switch and Handover. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/f_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_target"
            android:tint="@color/w_accent" />

        <TextView
            android:id="@+id/f_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chorus"
            android:textColor="@color/w_ink3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/f_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/f_orbit"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/f_l1" style="@style/WidgetLayerLabel" android:textColor="@color/w_accent" />
            <TextView android:id="@+id/f_n1" style="@style/WidgetLayerNames" android:textColor="@color/w_ink" />
            <TextView android:id="@+id/f_l2" style="@style/WidgetLayerLabel" android:textColor="@color/w_accent" />
            <TextView android:id="@+id/f_n2" style="@style/WidgetLayerNames" android:textColor="@color/w_ink" />
            <TextView android:id="@+id/f_l3" style="@style/WidgetLayerLabel" android:textColor="@color/w_ink3" />
            <TextView android:id="@+id/f_n3" style="@style/WidgetLayerNames" android:textColor="@color/w_ink3" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/f_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/f_switch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/w_button"
            android:drawableStart="@drawable/ic_switch_arrows"
            android:drawablePadding="8dp"
            android:drawableTint="@color/w_on_accent"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Switch"
            android:textColor="@color/w_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f_handover"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/w_button2"
            android:drawableStart="@drawable/ic_handover"
            android:drawablePadding="8dp"
            android:drawableTint="@color/w_ink"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Handover"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
