<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Charcoal canvas from the first frame, so launch never flashes a lighter window (D-079: dark default). -->
    <style name="Theme.Chorus" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/chorus_canvas</item>
        <item name="android:colorAccent">@color/chorus_teal</item>
    </style>
    <color name="chorus_canvas">#FF15161A</color>
    <color name="chorus_teal">#FF42A397</color>
    <!-- the front widget's layer labels and names (Figma F3.8) -->
    <style name="WidgetLayerLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="WidgetLayerNames">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
